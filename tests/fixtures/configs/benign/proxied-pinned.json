{
  "mcpServers": {
    "memory": {
      "command": "guardmcp",
      "args": [
        "proxy",
        "--log",
        "/tmp/memory.jsonl",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory@2026.8.31"
      ]
    },
    "someone-elses-proxy": {
      "command": "mcp-proxy",
      "args": ["proxy", "--", "npx", "-y", "not-guardmcp-so-not-unwrapped"]
    }
  }
}
