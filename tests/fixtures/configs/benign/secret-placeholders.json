{
  "mcpServers": {
    "registry-style": {
      "command": "npx",
      "args": ["-y", "example-mcp@1.2.0"],
      "env": {
        "SERVICE_API_KEY": "{service_api_key}",
        "WORKSPACE_TOKEN": "<YOUR_WORKSPACE_TOKEN>",
        "BILLING_SECRET": "[paste billing secret]"
      }
    },
    "vscode-style": {
      "command": "npx",
      "args": ["-y", "example-mcp@1.2.0"],
      "env": {
        "GITHUB_TOKEN": "${env:GITHUB_TOKEN}",
        "SEARCH_API_KEY": "${input:search-api-key}",
        "2Captcha_API_KEY": "${2Captcha_API_KEY}"
      }
    },
    "key-files": {
      "command": "node",
      "args": ["server.js"],
      "env": {
        "MCP_TLS_KEY": "./certs/server.key",
        "SSH_PRIVATE_KEY": "~/.ssh/id_ed25519",
        "SIGNING_KEY": "/etc/mcp/keys/signing.pem",
        "WIN_CLIENT_KEY": "C:\\keys\\client-private.pem"
      }
    }
  }
}
